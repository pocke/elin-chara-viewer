{
  "permissions": {
    "deny": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(tsx:*)",
      "Bash(corepack:*)",
      "Bash(bun:*)",
      "Bash(deno:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/deny-host-node.sh"
          }
        ]
      }
    ]
  }
}
