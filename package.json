{
  "name": "elin-chara-viewer",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "last 2 version",
    "not dead"
  ],
  "scripts": {
    "predev": "node script/copy-csv.cjs",
    "dev": "next dev",
    "prebuild": "node script/copy-csv.cjs",
    "build": "next build",
    "postbuild": "node script/prune-export.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:history": "tsx script/build-history.ts",
    "check:archive": "tsx script/check-archive.ts",
    "check:export": "tsx script/check-export.ts",
    "check:hidden": "ruby script/check-hidden-charas.rb",
    "check:history": "tsx script/check-history-provenance.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@sqlrooms/duckdb": "^0.29.0",
    "@sqlrooms/room-shell": "^0.29.0",
    "@sqlrooms/sql-editor": "^0.29.0",
    "@sqlrooms/ui": "^0.29.0",
    "csv-parse": "^7.0.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
